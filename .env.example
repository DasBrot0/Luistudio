# Docker Compose (copia este archivo como .env si deseas cambiar los valores).
# No uses las claves por defecto fuera de desarrollo.
POSTGRES_DB=luistudio_db
POSTGRES_USER=luistudio
POSTGRES_PASSWORD=luistudio_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@luistudio.com
PGADMIN_DEFAULT_PASSWORD=admin123
JWT_SECRET=cambia-esta-clave-por-una-segura

# Para ejecutar en otra PC/rede, reemplaza localhost por su IP o dominio.
CORS_ORIGINS=http://localhost
FRONTEND_RESET_PASSWORD_URL=http://localhost/restablecer-contrasena
FRONTEND_CONFIRM_CHANGE_URL=http://localhost/confirmar-cambio
AUTH_COOKIE_SECURE=false
EMAIL_PROVIDER=log
APP_LOG_LEVEL=INFO
# Clave de Groq para POST /api/rooms/intelligent-search (nunca la expongas en el frontend).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=12
VITE_MAPTILER_API_KEY=
VITE_MAP_STYLE_LIGHT_URL=https://api.maptiler.com/maps/streets-v2/style.json
VITE_MAP_STYLE_DARK_URL=https://api.maptiler.com/maps/streets-v2-dark/style.json
